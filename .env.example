# Copy to .env. Nothing here is required to import the package; each is read by the
# component that needs it, and every external service degrades to "unavailable" in the
# coverage manifest rather than raising.

# --- Router (deploy/graphhopper) ---
LONGRUN_GRAPHHOPPER_URL=http://localhost:8989

# --- PostGIS (deploy/postgis) ---
LONGRUN_POSTGIS_DSN=postgresql://longrun:longrun@localhost:5432/longrun

# --- Local storage roots ---
LONGRUN_DATA_DIR=./data
LONGRUN_CACHE_DIR=./data/cache
LONGRUN_PROFILE_PATH=~/.longrun/profile.yaml

# --- External APIs (see scope 7.4-7.7) ---
# NWS and Open-Meteo need no key; a contact string is required by the NWS user agent policy.
LONGRUN_NWS_USER_AGENT="longrun (you@example.com)"
LONGRUN_AIRNOW_API_KEY=
LONGRUN_PURPLEAIR_API_KEY=

# --- Jurisdiction adapters (scope 7.10, milestone M4) ---
# All free, all tied to an email address, all optional. Without one the adapter reports
# which key is missing by name rather than reporting that the jurisdiction had no closures -
# the same treatment HPMS gets in ADR 0012 and AirNow in ADR 0006. Dropping a key in here
# needs no code change.
#
# The WZDx feeds for Missouri, Kansas and Maricopa County need no key and are always on.
LONGRUN_511SF_API_KEY=      # https://511.org/open-data/token
LONGRUN_AZ511_API_KEY=      # https://www.az511.com/developers
LONGRUN_NPS_API_KEY=        # https://www.nps.gov/subjects/developer/get-started.htm

# --- LLM (agent/, tier-4 extraction adapters) ---
ANTHROPIC_API_KEY=

# --- Optional, off by default (scope 5, 12) ---
# User-supplied Strava cookies for heatmap tiles. ToS risk sits with the user.
LONGRUN_STRAVA_HEATMAP_COOKIES=
