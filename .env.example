# Copy to .env. Nothing here is required to import the package; each is read by the
# component that needs it, and every external service degrades to "unavailable" in the
# coverage manifest rather than raising.

# --- Router (deploy/graphhopper) ---
LONGRUN_GRAPHHOPPER_URL=http://localhost:8989

# --- PostGIS (deploy/postgis) ---
LONGRUN_POSTGIS_DSN=postgresql://longrun:longrun@localhost:5432/longrun

# --- Local storage roots ---
LONGRUN_DATA_DIR=./data
LONGRUN_CACHE_DIR=./data/cache
LONGRUN_PROFILE_PATH=~/.longrun/profile.yaml

# --- External APIs (see scope 7.4-7.7) ---
# NWS and Open-Meteo need no key; a contact string is required by the NWS user agent policy.
LONGRUN_NWS_USER_AGENT="longrun (you@example.com)"
LONGRUN_AIRNOW_API_KEY=
LONGRUN_PURPLEAIR_API_KEY=

# --- Jurisdiction adapters (scope 7.10, milestone M4) ---
# Free, tied to an email address, and optional. Without one the adapter reports which key is
# missing by name rather than reporting that the jurisdiction had no closures - the same
# treatment HPMS gets in ADR 0012 and AirNow in ADR 0006. Dropping a key in here needs no
# code change.
#
# Twenty of the twenty-two WZDx feeds need no key at all, and M14 called every one of them
# on 2026-09-23 to find out. `LONGRUN_AZ511_API_KEY` used to be listed here and has been
# removed - the AZ511 documentation says a key is required "for most API calls" and the
# WZDx endpoint is not one of them, which calling it settles and reading it did not.
#
# A keyed feed is adopted by whoever holds its key (ADR 0057), and only then listed here. The
# registry's other keyed feeds are `AWAITING_KEY` in `src/longrun/adapters/wzdx/__init__.py`,
# each with the URL to register at: holding one of those keys makes its adoption one commit.
# Oklahoma's and Florida's registry rows publish a shared credential inside the feed URL;
# copy it into your own .env if you want those states, and never into this repository.
LONGRUN_511SF_API_KEY=      # https://511.org/open-data/token
LONGRUN_MASSDOT_API_KEY=    # https://api-app.massdot-swzm.com/
LONGRUN_NPS_API_KEY=        # https://www.nps.gov/subjects/developer/get-started.htm

# --- Open-data portals (tier 3, M21) ---
# Optional even when used. Socrata answers anonymous queries at a lower rate limit, so every
# catalog dataset is asked with or without this; a token only makes a busy afternoon of
# plans less likely to be throttled. It changes no answer and is never part of a cache key.
LONGRUN_SOCRATA_APP_TOKEN=  # https://dev.socrata.com/docs/app-tokens.html

# --- Geocoding (scope 8.1 step 1) ---
# Nominatim needs no key and its usage policy requires a contact string. Never invented or
# borrowed: without one the geocoder makes no call and says which variable is missing, the
# same treatment NWS gets. See https://operations.osmfoundation.org/policies/nominatim/
LONGRUN_NOMINATIM_USER_AGENT="longrun (you@example.com)"

# --- Raster tiles (ADR 0023): the web UI basemap and the imagery_tile tool ---
# Unset means usgs-imagery: USGS The National Map, public domain, no key, US coverage,
# zoom 16 at most. Also: usgs-topo, none, or custom (which needs the next two, and
# LONGRUN_TILE_MAXZOOM if the provider stops before 19).
LONGRUN_TILE_PROVIDER=
LONGRUN_TILE_URL=
LONGRUN_TILE_ATTRIBUTION=

# --- LLM (agent/, tier-4 extraction adapters) ---
ANTHROPIC_API_KEY=

# --- Optional, off by default (scope 5, 12) ---
# User-supplied Strava cookies for heatmap tiles. ToS risk sits with the user.
LONGRUN_STRAVA_HEATMAP_COOKIES=

# --- Labels (ADR 0048) ---
# Who is labelling. Required by `longrun label`; never guessed from the OS or git user.
# Letters, digits, '-' and '_' - it names published pair files and `tune --labeler`.
LONGRUN_LABELER=
# Where a person's labels live before `longrun label publish`. Outside the repository on
# purpose: the repo is public, and a label keeps a copy of the plan it was written about.
# LONGRUN_LABELS_DIR=~/.longrun/labels
